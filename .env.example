# Copy to .env on EC2. Use real random values and keep this file out of Git.
POSTGRES_DB=emori
DB_URL=jdbc:postgresql://db:5432/emori
DB_USERNAME=emori
DB_PASSWORD=replace_with_a_long_random_hex_password
# Base64 of exactly 32 random bytes; keep the same value across restarts.
EMORI_IDEMPOTENCY_SECRET=replace_with_base64_of_32_random_bytes
AUTH_ACCESS_SECONDS=900
AUTH_REFRESH_SECONDS=2592000
PUSH_WORKER_ENABLED=false
EXPO_ACCESS_TOKEN=
# Optional local overrides. EC2 uses 80/443 and loopback 8080 by default.
APP_LOCAL_PORT=8080
HTTP_PORT=80
HTTPS_PORT=443
